# Copiá este archivo a .env y completalo:  cp .env.example .env

# --- Dominio y contacto ---
DOMAIN=news.blucaro.site
# Mail que aparece en /terminos para pedidos de alta/baja (se resuelven en 48 h).
CONTACT_EMAIL=CAMBIAR@ejemplo.com
SITE_NAME="Blucaro News"

# --- Admin (un solo usuario) ---
ADMIN_USER=admin
# Generalo con:  docker compose run --rm -it app node src/hash-password.js
# Dejá las comillas simples: el hash tiene signos "$".
ADMIN_PASSWORD_HASH=''

# --- Opcional ---
# API key gratuita de YouTube Data v3: habilita el estado "EN VIVO / sin vivo" por canal
# antes de cargar el player (≈1.000 unidades/día de las 10.000 gratis).
YT_API_KEY=
# Cada cuánto se leen los RSS (60 a 120 segundos).
RSS_INTERVAL_SEC=90

# Clima (por defecto Río Gallegos)
WEATHER_NAME="Río Gallegos"
WEATHER_LAT=-51.6226
WEATHER_LON=-69.2181

# --- Despliegue ---
# "caddy" levanta el proxy con HTTPS en 80/443. Si el VPS ya tiene nginx/Traefik
# en esos puertos, dejalo vacío y apuntá tu proxy a 127.0.0.1:${APP_LOCAL_PORT}.
COMPOSE_PROFILES=caddy
# Puerto local (solo 127.0.0.1) donde escucha la app.
APP_LOCAL_PORT=3080
